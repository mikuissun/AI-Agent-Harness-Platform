APP_NAME="AI Agent Harness Platform"
APP_ENV=local
DATABASE_URL=sqlite:///./tasks.db
DASHSCOPE_API_KEY=your-dashscope-api-key
LLM_MODEL=your-model-name
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1200
LLM_MAX_CALLS=16
WORKSPACE_ROOT=.
CLI_TIMEOUT_SECONDS=20
CLI_MAX_OUTPUT_CHARS=20000
MCP_MAX_READ_CHARS=20000
MCP_MAX_LIST_FILES=200
CHECKPOINT_DATABASE_URL=sqlite:///./workflow-checkpoints.db
WORKFLOW_MAX_ITERATIONS=3
RETRY_MAX_ATTEMPTS=2
WRITE_MAX_CHARS=20000
APPROVAL_ENCRYPTION_KEY=your-fernet-key-placeholder
